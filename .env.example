# Postgres (Neon) — checkout uses an interactive Prisma transaction, which needs
# a DIRECT (non-pooled) connection, so use the "Direct" connection string for BOTH
# vars. Only switch DATABASE_URL to "Pooled" if checkout is refactored to
# sequential writes. (Migrations must always use a direct connection.)
DATABASE_URL="postgresql://<user>:<password>@<host>.<region>.neon.tech/<db>?sslmode=require"
DIRECT_URL="postgresql://<user>:<password>@<host>.<region>.neon.tech/<db>?sslmode=require"
# NextAuth / App URL
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here"

# Firebase Client Configuration
NEXT_PUBLIC_FIREBASE_API_KEY="your-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-auth-domain"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-storage-bucket"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-app-id"

# Admin bootstrap (server-only secrets — NEVER commit real values, NEVER prefix with NEXT_PUBLIC_)
# The admin User is auto-provisioned with a bcrypt hash on first server start / seed.
# If ADMIN_PASSWORD is missing, no admin is created (fail closed).
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-to-a-strong-random-password"

# Session signing secret (required in production)
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Groq AI API Key
GROQ_API_KEY="your-groq-api-key"

# Sentry error monitoring (optional): when SENTRY_DSN is unset, the Sentry
# SDKs stay uninitialized and the app runs exactly as before (no-ops).
# Set both to also get browser error reports (client bundle needs NEXT_PUBLIC_).
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Optional Sentry identifiers for release/source-map uploads
SENTRY_ORG=""
SENTRY_PROJECT=""

# Structured JSON logging (src/lib/logger.ts): info | warn | error
LOG_LEVEL="info"

# Rate limiting (optional): Upstash Redis REST. When both are set, API rate
# limits are enforced globally; otherwise an in-memory fallback is used
# (single instance only — fine for local dev).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
